<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>true</IncludeBuildOutput>

    <!-- NuGet Package Metadata -->
    <PackageId>Datadog.MAUI.Symbols</PackageId>
    <!-- Override Directory.Build.props version - Symbols package has independent versioning -->
    <Version>0.0.2</Version>
    <PackageVersion>0.0.2</PackageVersion>
    <Authors>Datadog</Authors>
    <Company>Datadog</Company>
    <Description>MSBuild SDK for automatically uploading .NET MAUI debug symbols (dSYMs and Proguard mapping files) to Datadog during build/publish.</Description>
    <PackageTags>Datadog;MAUI;Symbols;dSYM;Proguard;Symbolication;MSBuild</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/kyletaylored/dd-sdk-maui</RepositoryUrl>
    <PackageProjectUrl>https://docs.datadoghq.com/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- MSBuild SDK Package Settings -->
    <DevelopmentDependency>false</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild Dependencies -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle a local datadog-ci npm tarball inside the NuGet -->
    <None Include="tools\datadog-ci.tgz" Pack="true" PackagePath="tools\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include the .targets file in the build folder of the NuGet package -->
    <None Include="build\Datadog.MAUI.Symbols.targets" Pack="true" PackagePath="build\" />
    <None Include="build\Datadog.MAUI.Symbols.targets" Pack="true" PackagePath="buildTransitive\" />

    <!-- Include README in the package -->
    <None Include="README.md" Pack="true" PackagePath="\" />

    <!-- Optional but recommended: include LICENSE if present -->
    <None Include="LICENSE" Pack="true" PackagePath="\" Condition="Exists('LICENSE')" />
  </ItemGroup>

  <!-- Fail the pack if the tgz is missing (prevents shipping a broken package) -->
  <Target Name="EnsureBundledDatadogCiExists" BeforeTargets="Pack">
    <Error Condition="!Exists('tools\datadog-ci.tgz')"
           Text="tools\datadog-ci.tgz is missing. Add it before packing so bundled datadog-ci mode can work." />
  </Target>

</Project>
