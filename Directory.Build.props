<Project>
  <PropertyGroup>
    <!-- Base SDK Version - Default version for all components when not individually specified -->
    <DatadogSdkVersion>3.5.0</DatadogSdkVersion>

    <!-- Native SDK Versions (what we fetch from upstream repos) -->
    <!-- These control which version of the native iOS/Android SDKs to download and bind -->
    <!-- Example: iOS releases 3.5.1 with critical fix, but Android still at 3.5.0 -->
    <DatadogAndroidSdkVersion Condition="'$(DatadogAndroidSdkVersion)' == ''">$(DatadogSdkVersion)</DatadogAndroidSdkVersion>
    <DatadogiOSSdkVersion Condition="'$(DatadogiOSSdkVersion)' == ''">$(DatadogSdkVersion)</DatadogiOSSdkVersion>

    <!-- Platform-Specific Binding Versions (NuGet package versions we publish) -->
    <!-- These default to the native SDK version they're binding, but can diverge for binding-specific fixes -->
    <!-- Example: Android binding needs C# marshalling patch -> set AndroidBindingVersion to 3.5.0.1 -->
    <AndroidBindingVersion Condition="'$(AndroidBindingVersion)' == ''">$(DatadogAndroidSdkVersion)</AndroidBindingVersion>
    <iOSBindingVersion Condition="'$(iOSBindingVersion)' == ''">$(DatadogiOSSdkVersion)</iOSBindingVersion>

    <!-- Plugin Version (the unified Datadog.MAUI package that references bindings) -->
    <!-- Can diverge from binding versions for plugin-only enhancements -->
    <PluginVersion Condition="'$(PluginVersion)' == ''">$(DatadogSdkVersion)</PluginVersion>

    <!-- Datadog Symbols Package Version - Independent versioning -->
    <DatadogSymbolsVersion>0.0.2</DatadogSymbolsVersion>

    <!-- Default Version for all packages (uses PluginVersion) -->
    <!-- Platform-specific bindings can override by setting Version=$(AndroidBindingVersion) or Version=$(iOSBindingVersion) -->
    <Version>$(PluginVersion)</Version>
    <PackageVersion>$(PluginVersion)</PackageVersion>

    <!-- Common Package Metadata -->
    <Authors>Datadog</Authors>
    <Company>Datadog</Company>
    <Product>Datadog SDK for .NET MAUI</Product>
    <Copyright>Copyright © Datadog $(Year)</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kyletaylored/dd-sdk-maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kyletaylored/dd-sdk-maui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>datadog;monitoring;rum;apm;logs;trace;maui;ios;android</PackageTags>
    <Description>Datadog SDK bindings for .NET MAUI applications</Description>

    <!-- Build Configuration -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Android Binding Configuration -->
    <!-- Disable Java dependency verification for Android bindings -->
    <!-- The Datadog Android SDK AARs include test dependencies in their Maven metadata -->
    <!-- which aren't needed at runtime and cause build failures -->
    <AndroidSkipJavaDependencyVerification>true</AndroidSkipJavaDependencyVerification>

    <!-- Suppress AndroidX transitive dependency version constraint warnings -->
    <!-- NU1608: These occur because .Ktx packages have strict version ranges but higher versions are resolved -->
    <!-- This is safe in practice and common in MAUI apps due to Microsoft.Maui's own AndroidX dependencies -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>
</Project>
