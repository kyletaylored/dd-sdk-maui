<Project>
  <!-- Import parent Directory.Build.props to inherit DatadogSdkVersion and other common properties -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Override Version to use iOS binding version for all iOS binding packages -->
    <Version>$(iOSBindingVersion)</Version>
    <PackageVersion>$(iOSBindingVersion)</PackageVersion>

    <!-- Suppress missing XML documentation warnings for binding projects -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
