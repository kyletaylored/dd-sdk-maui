<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Only targeting Android and iOS for Datadog SDK -->
		<TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>DatadogMauiSample</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Suppress missing XML documentation warnings for sample app -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<!-- Display name -->
		<ApplicationTitle>MAUI Shopist Demo</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.datadog.datadog-maui-shopist.demo</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Platform-specific settings -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Android-specific settings to fix tracing library conflicts -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-android' And '$(Configuration)' == 'Debug'">
		<!-- Use multidex and disable R8 optimizations for Debug to avoid duplicate class errors -->
		<AndroidDexTool>d8</AndroidDexTool>
		<AndroidEnableMultiDex>true</AndroidEnableMultiDex>
		<AndroidLinkMode>None</AndroidLinkMode>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidProguardFile>Platforms\Android\proguard-r8.txt</AndroidProguardFile>
		<!-- Disable Java dependency verification - Kotlin stdlib is embedded in Datadog SDK AARs -->
		<AndroidVerifyJavaDependencies>false</AndroidVerifyJavaDependencies>
	</PropertyGroup>

	<!-- Android Release configuration with R8 code shrinking -->
	<PropertyGroup Condition="$(TargetFramework.Contains('android')) And '$(Configuration)' == 'Release'">
		<!-- Use R8 as the link tool (modern guidance) -->
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<!-- Disable Java dependency verification - Kotlin stdlib is embedded in Datadog SDK AARs -->
		<AndroidVerifyJavaDependencies>false</AndroidVerifyJavaDependencies>
		<!-- Disable AOT for sample app to avoid compilation issues with bindings -->
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<!-- iOS dSYM Configuration (generates debug symbol files) -->
	<PropertyGroup Condition="$(TargetFramework.Contains('ios')) And '$(Configuration)' == 'Release'">
		<MtouchDebugSymbols>true</MtouchDebugSymbols>
		<GenerateDsymBundle>true</GenerateDsymBundle>
	</PropertyGroup>

	<!-- Datadog Symbol Upload Configuration (namespaced) -->
	<PropertyGroup>
		<!-- Read flavor from environment variable if set, otherwise default to configuration name -->
		<DatadogSymbolsFlavor Condition="'$(DD_BUILD_FLAVOR)' != ''">$(DD_BUILD_FLAVOR)</DatadogSymbolsFlavor>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('android'))">
		<DatadogSymbolsServiceNameAndroid>datadog-maui-android</DatadogSymbolsServiceNameAndroid>
		<DatadogSymbolsSite>datadoghq.com</DatadogSymbolsSite>

		<!-- Keep sample in dry-run by default to avoid accidental uploads; flip for real runs -->
		<DatadogSymbolsDryRun>true</DatadogSymbolsDryRun>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('ios'))">
		<DatadogSymbolsServiceNameiOS>datadog-maui-ios</DatadogSymbolsServiceNameiOS>
		<DatadogSymbolsSite>datadoghq.com</DatadogSymbolsSite>
		<DatadogSymbolsDryRun>true</DatadogSymbolsDryRun>
	</PropertyGroup>

	<!-- iOS Code Signing Configuration (untouched) -->
	<PropertyGroup Condition="$(TargetFramework.Contains('ios'))">
		<CodesignProvision></CodesignProvision>
		<CodesignKey>Apple Development</CodesignKey>
		<CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
		<DevelopmentTeam>LPGVJL9H49</DevelopmentTeam>
	</PropertyGroup>

	<!-- Custom target to remove duplicate tracing AAR before dex compilation -->
	<Target Name="RemoveDuplicateTracingAAR" BeforeTargets="_CompileToDalvik" Condition="'$(TargetFramework)' == 'net9.0-android'">
		<Exec Command="find $(IntermediateOutputPath)lp -type d -name '12*' -o -name '16*' | while read dir; do if [ -f &quot;$$dir/jl/classes.jar&quot; ] &amp;&amp; unzip -l &quot;$$dir/jl/classes.jar&quot; 2&gt;/dev/null | grep -q 'androidx/tracing/TraceKt.class' &amp;&amp; echo &quot;$$dir&quot; | grep -q '/12'; then echo &quot;Removing duplicate tracing-android from $$dir&quot;; rm -rf &quot;$$dir/jl/classes.jar&quot;; fi; done" IgnoreExitCode="true" Condition="Exists('$(IntermediateOutputPath)lp')" />
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
	</ItemGroup>

	<ItemGroup>
		<MauiAsset Include="appsettings.json" />
		<MauiAsset Include="appsettings.*.json" />
	</ItemGroup>

	<!-- Android-specific package exclusions -->
	<ItemGroup Condition="$(TargetFramework.Contains('android'))">
		<PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.10.0.1" ExcludeAssets="All" />
		<PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.4.0.1" />
		<PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.3.1.1" ExcludeAssets="compile;runtime;native" />
	</ItemGroup>

	<!-- Datadog.MAUI Plugin Reference Strategy -->
	<ItemGroup>
		<ProjectReference Include="..\..\Datadog.MAUI.Plugin\Datadog.MAUI.Plugin.csproj" />
	</ItemGroup>

	<!-- Load the Symbols MSBuild task from local build output (always from Release) -->
	<UsingTask TaskName="Datadog.MAUI.Symbols.UploadSymbolsTask" AssemblyFile="$(MSBuildProjectDirectory)\..\..\Datadog.MAUI.Symbols\bin\Release\netstandard2.0\Datadog.MAUI.Symbols.dll" />

	<!-- Import the Symbols upload target -->
	<Import Project="..\..\Datadog.MAUI.Symbols\build\Datadog.MAUI.Symbols.targets" />

	<!-- For CI builds, use PackageReference instead (commented out for local dev) -->
	<!--
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<PackageReference Include="Datadog.MAUI" Version="$(DatadogSdkVersion)" />
		<PackageReference Include="Datadog.MAUI.Symbols" Version="$(DatadogSymbolsVersion)" />
	</ItemGroup>
	-->

	<!-- Local NuGet source for Release builds (points to ./artifacts) -->
	<!-- CI builds will override this via nuget.config or command-line restore -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<RestoreAdditionalProjectSources>$(MSBuildProjectDirectory)/../../artifacts;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
	</PropertyGroup>
</Project>
