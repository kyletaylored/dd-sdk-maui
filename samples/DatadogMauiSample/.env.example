# ⚠️ DEPRECATED - This .env approach is no longer used
#
# Configuration has been migrated to standard .NET appsettings.json
#
# For local development:
# 1. Copy appsettings.Development.json.example to appsettings.Development.json:
#      cp samples/DatadogMauiSample/appsettings.Development.json.example samples/DatadogMauiSample/appsettings.Development.json
#
# 2. Fill in your Datadog credentials in appsettings.Development.json:
#      {
#        "Datadog": {
#          "Environment": "development",
#          "VerboseLogging": true,
#          "Android": {
#            "ClientToken": "your-android-client-token",
#            "RumApplicationId": "your-android-rum-application-id"
#          },
#          "iOS": {
#            "ClientToken": "your-ios-client-token",
#            "RumApplicationId": "your-ios-rum-application-id"
#          }
#        }
#      }
#
# 3. The appsettings.Development.json file is gitignored and will override base appsettings.json values
#
# See appsettings.Development.json.example for the complete configuration format
# See appsettings.json for all available configuration options
