{
  "Datadog": {
    "Environment": "dev",
    "ServiceName": "shopist-maui-demo",
    "Site": "US1",
    "FirstPartyHosts": [
      "fakestoreapi.com"
    ],
    "Android": {
      "ClientToken": "PLACEHOLDER_ANDROID_CLIENT_TOKEN",
      "RumApplicationId": "PLACEHOLDER_ANDROID_APPLICATION_ID"
    },
    "iOS": {
      "ClientToken": "PLACEHOLDER_IOS_CLIENT_TOKEN",
      "RumApplicationId": "PLACEHOLDER_IOS_APPLICATION_ID"
    },
    "Logs": {
      "Enabled": true
    },
    "Tracing": {
      "Enabled": true
    },
    "SessionReplay": {
      "Enabled": true,
      "SampleRate": 20,
      "TextAndInputPrivacy": "MaskSensitiveInputs",
      "ImagePrivacy": "MaskNonBundledOnly",
      "TouchPrivacy": "Show"
    }
  }
}
